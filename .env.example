# Copy to .env and adjust before running / deploying:
#   cp .env.example .env
#
# NOTE: NEXT_PUBLIC_* variables are BAKED IN at build time (Dockerfile build
# args) - changing them requires rebuilding the image (docker compose up -d --build).

# --- Local development (defaults work out of the box) ----------------------
# Backend API (Django). When unset, the frontend uses http://localhost:8000.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public URL of the site (sitemap, canonical/OG metadata).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production -------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://api.example.org
# NEXT_PUBLIC_SITE_URL=https://www.example.org
# Host address the frontend port binds to. Keep 127.0.0.1 behind a reverse proxy
# (the container trusts X-Forwarded-For); 0.0.0.0 only for testing from the LAN.
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=3000
# Host of NEXT_PUBLIC_API_BASE_URL when its reverse proxy runs on this machine:
# server-side rendering then reaches it directly, not through the CDN (docs/deployment.md).
# API_HOSTNAME=api.example.org
