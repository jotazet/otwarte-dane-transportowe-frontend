# Copy to .env and adjust before running / deploying:
#   cp .env.example .env
#
# UWAGA: zmienne NEXT_PUBLIC_* sa WYPIEKANE w build (Dockerfile build args) -
# zmiana wymaga przebudowania obrazu (docker compose up -d --build).

# --- Local development (defaults work out of the box) ----------------------
# Backend API (Django). Bez ustawienia frontend uzywa http://localhost:8000.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Publiczny adres frontu (sitemap, canonical/OG w metadanych).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production -------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://api.example.org
# NEXT_PUBLIC_SITE_URL=https://www.example.org
# Bind portu frontu na hoscie. Za reverse-proxy (nginx/Caddy) ustaw 127.0.0.1,
# zeby kontener nie byl widoczny z internetu bezposrednio.
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=3000
